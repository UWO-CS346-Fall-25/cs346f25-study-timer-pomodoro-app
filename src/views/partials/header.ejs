<header class="site-header">
  <nav class="container nav-bar">
    <a href="/" class="logo">FocusFlow</a>
    <ul class="nav-links">
      <% navLinks.forEach((link) => { %>
        <% const isActive = currentPath === link.href; %>
        <li>
          <a href="<%= link.href %>" class="<%= isActive ? 'active' : '' %>">
            <%= link.label %>
          </a>
        </li>
      <% }); %>
    </ul>
    <div class="account-actions">
      <% if (user) { %>
        <a href="/settings" class="button ghost small user-pill-btn settings-link">
          <i class="icon" data-lucide="user"></i>
          Hi, <%= user.username %>
        </a>
        <form action="/auth/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <button type="submit" class="button ghost small with-icon" id="logOut">
            <i data-lucide="log-out"></i>
            Logout
          </button>
        </form>
      <% } else { %>
        <a
          href="/auth/login"
          class="button small <%= currentPath === '/auth/login' ? 'primary' : 'ghost' %>"
        >
          Log in
        </a>
        <a
          href="/auth/register"
          class="button small <%= currentPath === '/auth/register' ? 'primary' : 'ghost' %>"
        >
          Sign up
        </a>
      <% } %>
    </div>
  </nav>
  <% if (flash) { %>
  <div
    data-flash
    data-flash-type="<%= flash.type %>"
    style="display:none;"
  ><%= flash.heading %></div>
<% } %>
</header>
