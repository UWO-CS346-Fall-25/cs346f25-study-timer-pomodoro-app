<%- include('partials/head') %>
<body class="page-settings">
  <%- include('partials/header') %>

  <main class="section">
    <div class="container container--narrow">

      <h1 class="page-title">Settings</h1>
      <p class="lead">Manage your FocusFlow profile and preferences.</p>

      <div class="settings-card">

        <div class="settings-row">
          <div class="settings-info">
            <h2>Profile Picture</h2>
            <p>Upload or update your display picture.</p>
          </div>

          <button class="button small mint" id="changeProfileBtn">
            Change profile picture
          </button>
          <form action="/settings/avatar/remove" method="POST" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button ghost small" type="submit" style="margin-left: 1rem;">
              Remove picture
            </button>
          </form>
        </div>

        <hr class="settings-divider" />

        <div class="settings-row">
          <div class="settings-info">
            <h2>Account Preferences</h2>
            <p>More customization coming soon.</p>
          </div>

          <button class="button ghost small" disabled>
            Coming soon
          </button>
        </div>

      </div>

    </div>
  </main>

  <div id="avatarModal" class="modal-overlay hidden">
    <div class="modal-box">
      <h2>Update Profile Picture</h2>

      <form id="avatarForm" enctype="multipart/form-data" method="POST" action="/settings/avatar">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" id="avatarFile" name="avatar" accept="image/*" required>
        <button type="submit" class="button primary small" style="margin-top: 1rem;">
          Upload
        </button>
      </form>

      <button id="closeAvatarModal" class="button ghost small" style="margin-top: 1rem;">
        Cancel
      </button>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
